  "nodes": [
    {
      "id": "salt_excess",
      "label": "塩分過多",
      "layer": "habit",
      "system": "diet",
      "summary": "食塩（ナトリウム）の過剰摂取。日本人の平均摂取量は目標値（1日6g未満）を大きく上回る。",
      "prevention": "減塩を意識し、麺類の汁・加工食品・漬物を控える。だし・酸味・香辛料で味を補う。"
    },
    {
      "id": "overeating",
      "label": "過食・高カロリー食",
      "layer": "habit",
      "system": "diet",
      "summary": "消費エネルギーを上回る摂取。内臓脂肪蓄積と食後高血糖の主因。",
      "prevention": "腹八分目・適正エネルギー。ゆっくりよく噛んで食べる。"
    },
    {
      "id": "sat_fat",
      "label": "飽和脂肪・トランス脂肪の過剰",
      "layer": "habit",
      "system": "diet",
      "summary": "肉の脂身・加工食品・揚げ物などに多い。血中LDLコレステロールを上げる。",
      "prevention": "脂身・加工肉を控え、魚・植物性の油に置き換える。"
    },
    {
      "id": "sugar_excess",
      "label": "糖質・加糖飲料の過剰",
      "layer": "habit",
      "system": "diet",
      "summary": "精製糖・清涼飲料の摂りすぎ。血糖負荷と肝での脂肪合成を高め、むし歯の原因にもなる。",
      "prevention": "加糖飲料を水・お茶に。間食・精製糖を控える。"
    },
    {
      "id": "fiber_lack",
      "label": "食物繊維・野菜不足",
      "layer": "habit",
      "system": "diet",
      "summary": "食後血糖の急上昇を招き、満腹感が得られにくく過食につながる。",
      "prevention": "野菜・海藻・きのこ・全粒穀物を先に食べる。"
    },
    {
      "id": "calcium_vitd_lack",
      "label": "カルシウム・ビタミンD不足",
      "layer": "habit",
      "system": "diet",
      "summary": "骨形成に必要な栄養の不足。骨密度の低下につながる。",
      "prevention": "乳製品・小魚・大豆製品・緑黄色野菜と適度な日光浴。必要に応じ補充。"
    },
    {
      "id": "phys_inactivity",
      "label": "運動不足",
      "layer": "habit",
      "system": "activity",
      "summary": "有酸素運動・筋トレの不足。エネルギー消費と骨格筋の糖取り込み、骨・筋肉の維持が低下する。",
      "prevention": "早歩き等の有酸素を週150分＋筋トレを週2回。"
    },
    {
      "id": "sitting",
      "label": "座位時間の過多",
      "layer": "habit",
      "system": "activity",
      "summary": "長時間の座りっぱなし。脂質代謝酵素の活性低下と独立した心血管リスク。",
      "prevention": "30〜60分ごとに立ち上がり、こまめに体を動かす。"
    },
    {
      "id": "smoking",
      "label": "喫煙",
      "layer": "habit",
      "system": "substance",
      "summary": "血管内皮の障害・動脈硬化促進・発がん・COPD・歯周病・加齢黄斑変性の最大級のリスク因子。",
      "prevention": "禁煙（禁煙外来の活用）。受動喫煙も避ける。"
    },
    {
      "id": "alcohol",
      "label": "過度の飲酒",
      "layer": "habit",
      "system": "substance",
      "summary": "純アルコール過剰。血圧・中性脂肪・尿酸を上げ、肝障害・一部のがん・骨量低下の原因。",
      "prevention": "純アルコール1日20g程度まで・週に休肝日。"
    },
    {
      "id": "sleep_lack",
      "label": "睡眠不足",
      "layer": "habit",
      "system": "lifestyle",
      "summary": "耐糖能低下・交感神経亢進・食欲ホルモンの乱れを招く。",
      "prevention": "6〜8時間の規則正しい睡眠を確保する。"
    },
    {
      "id": "stress",
      "label": "慢性ストレス",
      "layer": "habit",
      "system": "lifestyle",
      "summary": "交感神経緊張とコルチゾール上昇で血圧・内臓脂肪に悪影響。",
      "prevention": "運動・趣味・人とのつながり・呼吸法で回復の時間をつくる。"
    },
    {
      "id": "aging",
      "label": "加齢",
      "layer": "habit",
      "system": "other",
      "summary": "多くの疾患の背景となる非可逆的要因。白内障・加齢黄斑変性・緑内障・骨粗しょう症・サルコペニア・動脈硬化の共通の基盤。",
      "prevention": "加齢自体は避けられないが、他の生活習慣の管理で進行を緩やかにできる。"
    },
    {
      "id": "uv_exposure",
      "label": "紫外線曝露",
      "layer": "habit",
      "system": "environment",
      "summary": "強い紫外線への長期曝露。水晶体・網膜・皮膚に酸化ストレスを与える。",
      "prevention": "サングラス・つばの広い帽子・日焼け止めで防御する。"
    },
    {
      "id": "near_work",
      "label": "近業・デジタル端末の長時間使用",
      "layer": "habit",
      "system": "environment",
      "summary": "近距離作業・画面の長時間注視。近視の進行やドライアイに関与する。",
      "prevention": "20分ごとに20秒遠くを見る。適切な照度・作業距離・休憩。"
    },
    {
      "id": "poor_oral_care",
      "label": "口腔ケア不足",
      "layer": "habit",
      "system": "environment",
      "summary": "歯磨き・歯間清掃・歯科受診の不足。歯垢（プラーク）の蓄積で歯周病・むし歯を招く。",
      "prevention": "適切なブラッシングと歯間清掃、定期的な歯科健診・歯石除去。"
    },
    {
      "id": "visceral_fat",
      "label": "内臓脂肪の蓄積（肥満）",
      "layer": "risk",
      "system": "metabolic",
      "summary": "内臓周囲の脂肪過剰。アディポサイトカイン異常を通じ多くの病態の起点となり、関節への機械的負荷にもなる。",
      "prevention": "食事・運動で腹囲・体重を適正化する。"
    },
    {
      "id": "insulin_resistance",
      "label": "インスリン抵抗性",
      "layer": "risk",
      "system": "metabolic",
      "summary": "インスリンが効きにくくなる状態。高血糖・脂質異常の中核病態。",
      "prevention": "減量・有酸素運動・筋トレで感受性が改善する。"
    },
    {
      "id": "hyperglycemia",
      "label": "高血糖",
      "layer": "risk",
      "system": "metabolic",
      "summary": "血糖値の慢性的な上昇。糖化・酸化ストレスで全身の血管を傷害する。"
    },
    {
      "id": "dyslipidemia",
      "label": "脂質異常症（高LDL・高TG・低HDL）",
      "layer": "risk",
      "system": "metabolic",
      "summary": "血中脂質の異常。動脈硬化を進める主要因子。",
      "prevention": "飽和脂肪を控え、運動・減量。必要に応じ薬物治療。"
    },
    {
      "id": "hyperuricemia",
      "label": "高尿酸血症",
      "layer": "risk",
      "system": "metabolic",
      "summary": "血中尿酸の上昇。痛風発作・尿路結石・腎障害の原因。",
      "prevention": "プリン体・果糖・飲酒を控え、水分と減量。"
    },
    {
      "id": "hypertension",
      "label": "高血圧",
      "layer": "risk",
      "system": "vascular",
      "summary": "血管に持続的な高い圧力。動脈硬化・脳心血管・腎・眼底血管の障害の共通リスク。",
      "prevention": "減塩・減量・運動・節酒・家庭血圧測定。必要に応じ降圧薬。"
    },
    {
      "id": "chronic_inflammation",
      "label": "慢性炎症",
      "layer": "risk",
      "system": "metabolic",
      "summary": "内臓脂肪や歯周病などに由来する弱い炎症の持続。動脈硬化とインスリン抵抗性を悪化させる。"
    },
    {
      "id": "endothelial_dysfunction",
      "label": "血管内皮障害",
      "layer": "risk",
      "system": "vascular",
      "summary": "血管内皮の機能低下。一酸化窒素産生の低下で動脈硬化の初期段階となる。"
    },
    {
      "id": "atherosclerosis",
      "label": "動脈硬化（アテローム性）",
      "layer": "risk",
      "system": "vascular",
      "summary": "血管壁へのコレステロール沈着とプラーク形成。臓器虚血の共通経路。"
    },
    {
      "id": "metabolic_syndrome",
      "label": "メタボリックシンドローム",
      "layer": "risk",
      "system": "metabolic",
      "summary": "内臓肥満に高血糖・高血圧・脂質異常が重なった状態。リスクが相乗する。"
    },
    {
      "id": "myopia",
      "label": "近視・強度近視",
      "layer": "risk",
      "system": "ophthalmic",
      "summary": "眼軸の延長による屈折異常。強度近視は緑内障・網膜剥離・近視性黄斑症のリスクを高める。",
      "prevention": "屋外活動・近業の休憩。定期的な眼科検査。"
    },
    {
      "id": "high_iop",
      "label": "眼圧上昇",
      "layer": "risk",
      "system": "ophthalmic",
      "summary": "眼内の圧が高い状態。視神経を圧迫し緑内障の危険因子となる（正常眼圧でも発症しうる）。"
    },
    {
      "id": "t2dm",
      "label": "2型糖尿病",
      "layer": "disease",
      "system": "metabolic",
      "summary": "慢性高血糖が確立した状態。全身の大血管・細小血管合併症を招き、歯周病とも相互に悪化する。",
      "prevention": "食事・運動・減量が基本。血糖・HbA1c の管理と定期的な合併症検査。"
    },
    {
      "id": "ischemic_heart",
      "label": "虚血性心疾患（狭心症・心筋梗塞）",
      "layer": "disease",
      "system": "vascular",
      "summary": "冠動脈の狭窄・閉塞による心筋の虚血・壊死。"
    },
    {
      "id": "stroke_infarct",
      "label": "脳梗塞",
      "layer": "disease",
      "system": "neuro",
      "summary": "脳動脈の血栓・塞栓による脳組織の虚血。"
    },
    {
      "id": "stroke_hemorrhage",
      "label": "脳出血",
      "layer": "disease",
      "system": "neuro",
      "summary": "高血圧などで脆弱化した脳内細動脈の破綻。"
    },
    {
      "id": "ckd",
      "label": "慢性腎臓病（CKD）",
      "layer": "disease",
      "system": "renal",
      "summary": "腎機能の持続的な低下。高血圧・糖尿病が二大原因で、心血管リスクも高める。"
    },
    {
      "id": "nafld",
      "label": "脂肪肝（NAFLD/NASH）",
      "layer": "disease",
      "system": "hepatic",
      "summary": "肝への脂肪蓄積。炎症を伴うNASHは線維化・肝硬変へ進む。"
    },
    {
      "id": "gout",
      "label": "痛風",
      "layer": "disease",
      "system": "metabolic",
      "summary": "尿酸塩結晶が関節に沈着して起こる急性関節炎。"
    },
    {
      "id": "copd",
      "label": "慢性閉塞性肺疾患（COPD）",
      "layer": "disease",
      "system": "respiratory",
      "summary": "主に喫煙による気道・肺胞の慢性炎症と気流閉塞。"
    },
    {
      "id": "pad",
      "label": "末梢動脈疾患（PAD）",
      "layer": "disease",
      "system": "vascular",
      "summary": "四肢（主に下肢）動脈の狭窄・閉塞による血流障害。"
    },
    {
      "id": "cancer",
      "label": "一部のがん",
      "layer": "disease",
      "system": "other",
      "summary": "喫煙・飲酒・肥満が関与する各種がん（肺・肝・食道・大腸など）。"
    },
    {
      "id": "cataract",
      "label": "白内障",
      "layer": "disease",
      "system": "ophthalmic",
      "summary": "水晶体の混濁による視力低下。加齢が主因で、紫外線・喫煙・糖尿病が促進する。手術で治療可能。",
      "prevention": "紫外線対策・禁煙・血糖管理。進行時は手術で回復。"
    },
    {
      "id": "glaucoma",
      "label": "緑内障",
      "layer": "disease",
      "system": "ophthalmic",
      "summary": "視神経が障害され視野が欠けていく病気。日本の中途失明の主要原因。自覚が乏しく健診が重要。",
      "prevention": "定期的な眼科健診で早期発見し、眼圧を下げる治療で進行を抑える。"
    },
    {
      "id": "amd",
      "label": "加齢黄斑変性",
      "layer": "disease",
      "system": "ophthalmic",
      "summary": "網膜の中心（黄斑）が加齢で障害され中心視力が低下。喫煙が最大の可変リスク。",
      "prevention": "禁煙・紫外線対策・緑黄色野菜。早期発見で抗VEGF治療など。"
    },
    {
      "id": "rvo",
      "label": "網膜静脈閉塞症",
      "layer": "disease",
      "system": "ophthalmic",
      "summary": "網膜の静脈が詰まり出血・むくみを来す。高血圧・動脈硬化が主要因。",
      "prevention": "血圧・脂質・血糖の管理。"
    },
    {
      "id": "dry_eye",
      "label": "ドライアイ",
      "layer": "disease",
      "system": "ophthalmic",
      "summary": "涙液の減少・質の低下で眼表面が乾く。長時間の画面注視や加齢で増える。",
      "prevention": "こまめな休憩・まばたき・室内加湿。必要に応じ点眼。"
    },
    {
      "id": "periodontitis",
      "label": "歯周病",
      "layer": "disease",
      "system": "dental",
      "summary": "歯を支える組織の慢性細菌感染・炎症。歯の喪失原因の第1位で、糖尿病・動脈硬化・誤嚥性肺炎とも関連する。",
      "prevention": "プラークコントロール（歯磨き・歯間清掃）と定期的な歯科メンテナンス・禁煙。"
    },
    {
      "id": "dental_caries",
      "label": "齲蝕（むし歯）",
      "layer": "disease",
      "system": "dental",
      "summary": "細菌が糖から作る酸で歯質が溶ける病気。放置で歯髄炎・歯の喪失に至る。",
      "prevention": "糖の頻回摂取を控え、フッ化物・適切な歯磨き・定期健診。"
    },
    {
      "id": "osteoporosis",
      "label": "骨粗しょう症",
      "layer": "disease",
      "system": "musculoskeletal",
      "summary": "骨密度・骨質の低下で骨がもろくなる。加齢・運動不足・栄養不足・喫煙・飲酒が関与し、骨折リスクを高める。",
      "prevention": "カルシウム・ビタミンD・運動・禁煙・節酒。必要に応じ骨密度検査と薬物治療。"
    },
    {
      "id": "knee_oa",
      "label": "変形性膝関節症",
      "layer": "disease",
      "system": "musculoskeletal",
      "summary": "膝関節軟骨の摩耗による痛み・可動域制限。肥満と加齢が主要因で、活動低下の悪循環を招く。",
      "prevention": "減量・大腿四頭筋の筋トレ・適切な運動。"
    },
    {
      "id": "sarcopenia",
      "label": "サルコペニア（筋肉減少）",
      "layer": "disease",
      "system": "musculoskeletal",
      "summary": "加齢や不活動・低栄養による骨格筋量・筋力の低下。転倒・フレイルの原因。",
      "prevention": "十分なタンパク質摂取とレジスタンス運動。"
    },
    {
      "id": "diabetic_nephropathy",
      "label": "糖尿病腎症",
      "layer": "complication",
      "system": "renal",
      "summary": "高血糖による糸球体の微小血管障害。透析導入の最多原因。"
    },
    {
      "id": "diabetic_retinopathy",
      "label": "糖尿病網膜症",
      "layer": "complication",
      "system": "ophthalmic",
