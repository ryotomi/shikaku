  "nodes": [
    { "id": "salt_excess", "label": "塩分過多", "layer": "habit", "system": "diet", "summary": "食塩（ナトリウム）の過剰摂取。日本人の平均摂取量は目標値（1日6g未満）を大きく上回る。" },
    { "id": "overeating", "label": "過食・高カロリー食", "layer": "habit", "system": "diet", "summary": "消費エネルギーを上回る摂取。内臓脂肪蓄積と食後高血糖の主因。" },
    { "id": "sat_fat", "label": "飽和脂肪・トランス脂肪の過剰", "layer": "habit", "system": "diet", "summary": "肉の脂身・加工食品・揚げ物などに多い。血中LDLコレステロールを上げる。" },
    { "id": "sugar_excess", "label": "糖質・加糖飲料の過剰", "layer": "habit", "system": "diet", "summary": "精製糖・清涼飲料の摂りすぎ。血糖負荷と肝での脂肪合成を高める。" },
    { "id": "fiber_lack", "label": "食物繊維・野菜不足", "layer": "habit", "system": "diet", "summary": "食後血糖の急上昇を招き、満腹感が得られにくく過食につながる。" },
    { "id": "phys_inactivity", "label": "運動不足", "layer": "habit", "system": "activity", "summary": "有酸素運動・筋トレの不足。エネルギー消費と骨格筋の糖取り込みが低下する。" },
    { "id": "sitting", "label": "座位時間の過多", "layer": "habit", "system": "activity", "summary": "長時間の座りっぱなし。脂質代謝酵素の活性低下と独立した心血管リスク。" },
    { "id": "smoking", "label": "喫煙", "layer": "habit", "system": "substance", "summary": "血管内皮の障害・動脈硬化促進・発がん・COPDの最大級のリスク因子。" },
    { "id": "alcohol", "label": "過度の飲酒", "layer": "habit", "system": "substance", "summary": "純アルコール過剰。血圧・中性脂肪・尿酸を上げ、肝障害・一部のがんの原因。" },
    { "id": "sleep_lack", "label": "睡眠不足", "layer": "habit", "system": "lifestyle", "summary": "耐糖能低下・交感神経亢進・食欲ホルモンの乱れを招く。" },
    { "id": "stress", "label": "慢性ストレス", "layer": "habit", "system": "lifestyle", "summary": "交感神経緊張とコルチゾール上昇で血圧・内臓脂肪に悪影響。" },

    { "id": "visceral_fat", "label": "内臓脂肪の蓄積（肥満）", "layer": "risk", "system": "metabolic", "summary": "内臓周囲の脂肪過剰。アディポサイトカイン異常を通じ多くの病態の起点となる。" },
    { "id": "insulin_resistance", "label": "インスリン抵抗性", "layer": "risk", "system": "metabolic", "summary": "インスリンが効きにくくなる状態。高血糖・脂質異常の中核病態。" },
    { "id": "hyperglycemia", "label": "高血糖", "layer": "risk", "system": "metabolic", "summary": "血糖値の慢性的な上昇。糖化・酸化ストレスで血管を傷害する。" },
    { "id": "dyslipidemia", "label": "脂質異常症（高LDL・高TG・低HDL）", "layer": "risk", "system": "metabolic", "summary": "血中脂質の異常。動脈硬化を進める主要因子。" },
    { "id": "hyperuricemia", "label": "高尿酸血症", "layer": "risk", "system": "metabolic", "summary": "血中尿酸の上昇。痛風発作・尿路結石・腎障害の原因。" },
    { "id": "hypertension", "label": "高血圧", "layer": "risk", "system": "vascular", "summary": "血管に持続的な高い圧力。動脈硬化・脳心血管・腎障害の共通リスク。" },
    { "id": "chronic_inflammation", "label": "慢性炎症", "layer": "risk", "system": "metabolic", "summary": "内臓脂肪由来の弱い炎症の持続。動脈硬化とインスリン抵抗性を悪化させる。" },
    { "id": "endothelial_dysfunction", "label": "血管内皮障害", "layer": "risk", "system": "vascular", "summary": "血管内皮の機能低下。一酸化窒素産生の低下で動脈硬化の初期段階となる。" },
    { "id": "atherosclerosis", "label": "動脈硬化（アテローム性）", "layer": "risk", "system": "vascular", "summary": "血管壁へのコレステロール沈着とプラーク形成。臓器虚血の共通経路。" },
    { "id": "metabolic_syndrome", "label": "メタボリックシンドローム", "layer": "risk", "system": "metabolic", "summary": "内臓肥満に高血糖・高血圧・脂質異常が重なった状態。リスクが相乗する。" },

    { "id": "t2dm", "label": "2型糖尿病", "layer": "disease", "system": "metabolic", "summary": "慢性高血糖が確立した状態。全身の大血管・細小血管合併症を招く。" },
    { "id": "ischemic_heart", "label": "虚血性心疾患（狭心症・心筋梗塞）", "layer": "disease", "system": "vascular", "summary": "冠動脈の狭窄・閉塞による心筋の虚血・壊死。" },
    { "id": "stroke_infarct", "label": "脳梗塞", "layer": "disease", "system": "neuro", "summary": "脳動脈の血栓・塞栓による脳組織の虚血。" },
    { "id": "stroke_hemorrhage", "label": "脳出血", "layer": "disease", "system": "neuro", "summary": "高血圧などで脆弱化した脳内細動脈の破綻。" },
    { "id": "ckd", "label": "慢性腎臓病（CKD）", "layer": "disease", "system": "renal", "summary": "腎機能の持続的な低下。高血圧・糖尿病が二大原因で、心血管リスクも高める。" },
    { "id": "nafld", "label": "脂肪肝（NAFLD/NASH）", "layer": "disease", "system": "hepatic", "summary": "肝への脂肪蓄積。炎症を伴うNASHは線維化・肝硬変へ進む。" },
    { "id": "gout", "label": "痛風", "layer": "disease", "system": "metabolic", "summary": "尿酸塩結晶が関節に沈着して起こる急性関節炎。" },
    { "id": "copd", "label": "慢性閉塞性肺疾患（COPD）", "layer": "disease", "system": "respiratory", "summary": "主に喫煙による気道・肺胞の慢性炎症と気流閉塞。" },
    { "id": "pad", "label": "末梢動脈疾患（PAD）", "layer": "disease", "system": "vascular", "summary": "四肢（主に下肢）動脈の狭窄・閉塞による血流障害。" },
    { "id": "cancer", "label": "一部のがん", "layer": "disease", "system": "other", "summary": "喫煙・飲酒・肥満が関与する各種がん（肺・肝・食道・大腸など）。" },

    { "id": "diabetic_nephropathy", "label": "糖尿病腎症", "layer": "complication", "system": "renal", "summary": "高血糖による糸球体の微小血管障害。透析導入の最多原因。" },
    { "id": "diabetic_retinopathy", "label": "糖尿病網膜症", "layer": "complication", "system": "neuro", "summary": "網膜の微小血管障害。進行すると硝子体出血・網膜剥離を来す。" },
    { "id": "diabetic_neuropathy", "label": "糖尿病神経障害", "layer": "complication", "system": "neuro", "summary": "末梢神経の代謝・微小血管障害。足潰瘍・感覚低下の原因。" },
    { "id": "heart_failure", "label": "心不全", "layer": "complication", "system": "vascular", "summary": "心臓のポンプ機能低下。心筋梗塞・高血圧・弁膜症などの終着点。" },
    { "id": "aortic_aneurysm", "label": "大動脈瘤・大動脈解離", "layer": "complication", "system": "vascular", "summary": "動脈壁の脆弱化による拡張・裂け。破裂は致死的。" },

    { "id": "renal_failure", "label": "腎不全・透析", "layer": "outcome", "system": "renal", "summary": "末期腎不全。透析または腎移植が必要になる。" },
    { "id": "blindness", "label": "失明・重度視力障害", "layer": "outcome", "system": "neuro", "summary": "増殖網膜症などによる視機能の喪失。成人失明の主要原因。" },
    { "id": "amputation", "label": "下肢切断", "layer": "outcome", "system": "vascular", "summary": "重症下肢虚血・難治性足潰瘍・感染による切断。" },
    { "id": "vascular_dementia", "label": "血管性認知症", "layer": "outcome", "system": "neuro", "summary": "多発梗塞や慢性脳虚血による認知機能の低下。" },
    { "id": "liver_cirrhosis", "label": "肝硬変", "layer": "outcome", "system": "hepatic", "summary": "慢性肝障害の終末像。肝がん・肝不全のリスク。" },
    { "id": "death", "label": "死亡・突然死", "layer": "outcome", "system": "other", "summary": "致死性不整脈・血管破綻・臓器不全などによる死亡。" }
  ],
